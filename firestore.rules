rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isOIC() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'OIC';
    }

    function isAdminBranch() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN_BRANCH';
    }

    function isValidUser(data) {
      return data.uid is string &&
             data.displayName is string &&
             data.email is string &&
             data.role in ['OFFICER', 'OIC', 'ADMIN_BRANCH'] &&
             data.status in ['PENDING', 'APPROVED', 'REJECTED', 'REMOVED'] &&
             (!('oicEmail' in data) || data.oicEmail is string) &&
             (!('oicStationCode' in data) || data.oicStationCode == null || data.oicStationCode is string) &&
             (!('stationName' in data) || data.stationName is string) &&
             (!('badgeNumber' in data) || data.badgeNumber is string) &&
             (!('rank' in data) || data.rank is string) &&
             (!('phoneNumber' in data) || data.phoneNumber is string) &&
             (!('address' in data) || data.address is string) &&
             (!('fcmToken' in data) || data.fcmToken is string) &&
             (!('isOnDuty' in data) || data.isOnDuty is bool) &&
             (!('hiddenFromStationLists' in data) || data.hiddenFromStationLists is bool) &&
             (!('hiddenOnMap' in data) || data.hiddenOnMap is bool) &&
             (!('pauseLocationLogging' in data) || data.pauseLocationLogging is bool) &&
             (!('hideDutyStatus' in data) || data.hideDutyStatus is bool) &&
             (!('hasCameraPermission' in data) || data.hasCameraPermission is bool) &&
             (!('hasMicPermission' in data) || data.hasMicPermission is bool) &&
             (!('lastLocation' in data) || data.lastLocation is map) &&
             (!('lastOffDutyLocation' in data) || data.lastOffDutyLocation is map) &&
             (!('adminSecretSeed' in data) || data.adminSecretSeed is string) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      
      allow create: if isOwner(userId) && 
                       incoming().uid == userId &&
                       incoming().role in ['OFFICER', 'OIC', 'ADMIN_BRANCH'] &&
                       incoming().status in ['PENDING', 'APPROVED'] &&
                       isValidUser(incoming());
      
      allow update: if (isOwner(userId) && 
                        incoming().uid == existing().uid &&
                        incoming().role == existing().role &&
                        incoming().email == existing().email &&
                        isValidUser(incoming())) ||
                       (isSignedIn() && 
                        incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
                        incoming().status in ['APPROVED', 'REJECTED']) ||
                       (isSignedIn() &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['oicStationCode', 'status']) &&
                        incoming().status in ['PENDING', 'APPROVED'] &&
                        incoming().oicStationCode is string) ||
                       (isOIC() &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['oicStationCode', 'status', 'isOnDuty', 'updatedAt']) &&
                        incoming().status == 'REMOVED' &&
                        incoming().isOnDuty == false &&
                        incoming().oicStationCode == "");
    }

    function isValidDutyRecord(data) {
      return data.officerId is string &&
             (!('oicEmail' in data) || data.oicEmail is string) &&
             (!('oicStationCode' in data) || data.oicStationCode is string) &&
             data.type in ['ON_DUTY', 'OFF_DUTY', 'EXTRA_DUTY'] &&
             data.timestamp is number &&
             (!('ibPage' in data) || data.ibPage is string) &&
             (!('ibParagraph' in data) || data.ibParagraph is string) &&
             (!('dutyNature' in data) || data.dutyNature is string) &&
             (!('remarks' in data) || data.remarks is string) &&
             (!('photoPath' in data) || data.photoPath is string) &&
             (!('scenePhotoPath' in data) || data.scenePhotoPath is string) &&
             (!('dutyDurationMinutes' in data) || data.dutyDurationMinutes is number) &&
             (!('createdAt' in data) || data.createdAt is timestamp);
    }

    match /duty_records/{recordId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && 
                       incoming().officerId == request.auth.uid &&
                       isValidDutyRecord(incoming());
      allow update: if isSignedIn() && 
                       existing().officerId == request.auth.uid &&
                       incoming().officerId == existing().officerId &&
                       isValidDutyRecord(incoming());
      allow delete: if isSignedIn() && existing().officerId == request.auth.uid;
    }

    function isValidMessRecord(data) {
      return data.officerId is string &&
             (!('oicEmail' in data) || data.oicEmail is string) &&
             (!('oicStationCode' in data) || data.oicStationCode is string) &&
             data.date is string &&
             data.mealType in ['BREAKFAST', 'LUNCH', 'DINNER'] &&
             data.isTaken is bool &&
             data.price is number &&
             (!('mealNotes' in data) || data.mealNotes is string) &&
             (!('photoPath' in data) || data.photoPath is string) &&
             data.timestamp is number &&
             (!('createdAt' in data) || data.createdAt is timestamp);
    }

    match /mess_records/{recordId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && 
                       incoming().officerId == request.auth.uid &&
                       isValidMessRecord(incoming());
      allow update: if isSignedIn() && 
                       existing().officerId == request.auth.uid &&
                       incoming().officerId == existing().officerId &&
                       isValidMessRecord(incoming());
      allow delete: if isSignedIn() && existing().officerId == request.auth.uid;
    }

    function isValidRunningChartRecord(data) {
      return data.officerId is string &&
             (!('oicStationCode' in data) || data.oicStationCode is string) &&
             data.date is string &&
             data.vehicleNumber is string &&
             data.startMeter is number &&
             data.endMeter is number &&
             data.distanceKm is number &&
             data.kmPerLiter is number &&
             data.startFuel is number &&
             data.addedFuel is number &&
             data.consumedFuel is number &&
             data.remainingFuel is number &&
             (!('notes' in data) || data.notes is string) &&
             data.timestamp is number &&
             (!('createdAt' in data) || data.createdAt is timestamp);
    }

    match /running_chart_records/{recordId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
                       incoming().officerId == request.auth.uid &&
                       isValidRunningChartRecord(incoming());
      allow update: if isSignedIn() &&
                       existing().officerId == request.auth.uid &&
                       incoming().officerId == existing().officerId &&
                       isValidRunningChartRecord(incoming());
      allow delete: if isSignedIn() && existing().officerId == request.auth.uid;
    }

    function isValidTeamDutySession(data) {
      return data.sessionId is string &&
             data.joinCode is string && data.joinCode.size() >= 4 && data.joinCode.size() <= 16 &&
             data.leaderUid is string &&
             data.leaderName is string &&
             (!('leaderBadge' in data) || data.leaderBadge is string) &&
             (!('leaderRank' in data) || data.leaderRank is string) &&
             data.oicStationCode is string &&
             data.dutyNature is string &&
             (!('ibPage' in data) || data.ibPage is string) &&
             (!('ibParagraph' in data) || data.ibParagraph is string) &&
             (!('remarks' in data) || data.remarks is string) &&
             data.status in ['ACTIVE', 'ENDED'] &&
             data.startedAtMs is number &&
             (!('endedAtMs' in data) || data.endedAtMs is number) &&
             (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidTeamDutyMember(data) {
      return data.uid is string &&
             data.displayName is string &&
             (!('rank' in data) || data.rank is string) &&
             (!('badgeNumber' in data) || data.badgeNumber is string) &&
             (!('phoneNumber' in data) || data.phoneNumber is string) &&
             data.roleInTeam in ['LEADER', 'MEMBER'] &&
             data.status in ['ACTIVE', 'LEFT', 'ENDED_BY_LEADER'] &&
             data.joinedAtMs is number;
    }

    match /team_duties/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
                       incoming().leaderUid == request.auth.uid &&
                       incoming().status == 'ACTIVE' &&
                       isValidTeamDutySession(incoming());
      allow update: if isSignedIn() &&
                       existing().leaderUid == request.auth.uid &&
                       incoming().leaderUid == existing().leaderUid &&
                       isValidTeamDutySession(incoming());
      allow delete: if isSignedIn() && existing().leaderUid == request.auth.uid;

      match /members/{memberUid} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() &&
                                 request.auth.uid == memberUid &&
                                 incoming().uid == memberUid &&
                                 isValidTeamDutyMember(incoming());
        allow delete: if isSignedIn() && request.auth.uid == memberUid;
      }
    }

    function isValidNotification(data) {
      return data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.message is string && data.message.size() >= 1 && data.message.size() <= 1000 &&
             data.senderUid is string &&
             data.senderName is string && data.senderName.size() <= 100 &&
             data.senderRole in ['OIC', 'OFFICER', 'ADMIN_BRANCH'] &&
             data.targetType in ['ALL', 'STATION', 'USER'] &&
             (!('targetStationCode' in data) || data.targetStationCode is string) &&
             (!('targetUid' in data) || data.targetUid is string) &&
             data.priority in ['NORMAL', 'URGENT'] &&
             data.createdAtMs is number &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (
        resource.data.targetType == 'ALL' ||
        resource.data.senderUid == request.auth.uid ||
        resource.data.targetUid == request.auth.uid ||
        (resource.data.targetType == 'STATION' &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.oicStationCode == resource.data.targetStationCode)
      );
      allow create: if isSignedIn() &&
        incoming().senderUid == request.auth.uid &&
        isValidNotification(incoming()) &&
        (incoming().targetType != 'ALL' || isOIC() || isAdminBranch());
      allow delete: if isSignedIn() && resource.data.senderUid == request.auth.uid;
    }

    function isValidDutyAssignment(data) {
      return data.id is string &&
             data.officerId is string &&
             data.officerName is string &&
             (!('officerBadge' in data) || data.officerBadge is string) &&
             (!('officerRank' in data) || data.officerRank is string) &&
             (!('officerPhone' in data) || data.officerPhone is string) &&
             data.oicStationCode is string &&
             data.dateKey is string &&
             data.dutyNature is string &&
             (!('shift' in data) || data.shift is string) &&
             (!('remarks' in data) || data.remarks is string) &&
             data.assignedByUid is string &&
             (!('assignedByName' in data) || data.assignedByName is string) &&
             data.status in ['ASSIGNED', 'COMPLETED', 'MODIFIED'] &&
             data.createdAtMs is number &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time));
    }

    match /duty_assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidDutyAssignment(incoming());
      allow delete: if isSignedIn();
    }

    function isValidLocationHistory(data) {
      return data.officerId is string &&
             (!('officerName' in data) || data.officerName is string) &&
             (!('oicStationCode' in data) || data.oicStationCode is string) &&
             data.dateKey is string && data.dateKey.size() == 10 &&
             data.dayStationKey is string &&
             data.officerDayKey is string &&
             data.lat is number && data.lat >= -90 && data.lat <= 90 &&
             data.lng is number && data.lng >= -180 && data.lng <= 180 &&
             (!('accuracy' in data) || data.accuracy is number) &&
             data.dutyType in ['ON_DUTY', 'OFF_DUTY'] &&
             data.timestamp is number &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time));
    }

    match /location_history/{entryId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
                       incoming().officerId == request.auth.uid &&
                       isValidLocationHistory(incoming());
      allow update, delete: if isSignedIn() && existing().officerId == request.auth.uid;
    }

    function isValidEmergencyAlert(data) {
      return data.senderUid is string &&
             data.senderName is string && data.senderName.size() <= 120 &&
             (!('senderRank' in data) || data.senderRank is string) &&
             (!('senderBadge' in data) || data.senderBadge is string) &&
             data.senderRole in ['OIC', 'OFFICER', 'ADMIN_BRANCH'] &&
             (!('senderPhone' in data) || data.senderPhone is string) &&
             (!('oicStationCode' in data) || data.oicStationCode is string) &&
             data.message is string && data.message.size() >= 1 && data.message.size() <= 600 &&
             data.lat is number && data.lat >= -90 && data.lat <= 90 &&
             data.lng is number && data.lng >= -180 && data.lng <= 180 &&
             data.radiusKm is number && data.radiusKm > 0 && data.radiusKm <= 200 &&
             data.status in ['ACTIVE', 'RESOLVED'] &&
             data.createdAtMs is number &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time));
    }

    match /emergency_alerts/{alertId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
                       incoming().senderUid == request.auth.uid &&
                       incoming().status == 'ACTIVE' &&
                       isValidEmergencyAlert(incoming());
      allow update: if isSignedIn() &&
                       (existing().senderUid == request.auth.uid || isOIC()) &&
                       incoming().senderUid == existing().senderUid &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
                       incoming().status in ['ACTIVE', 'RESOLVED'];
      allow delete: if isSignedIn() &&
                       (existing().senderUid == request.auth.uid || isOIC());
    }

    function isValidStationChatMessage(data) {
      return data.oicStationCode is string && data.oicStationCode.size() >= 1 && data.oicStationCode.size() <= 64 &&
             data.senderUid is string && data.senderUid == request.auth.uid &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 120 &&
             data.senderRole in ['OIC', 'ADMIN_BRANCH', 'OFFICER'] &&
             (!('senderRank' in data) || data.senderRank is string) &&
             (!('senderBadge' in data) || data.senderBadge is string) &&
             data.message is string && data.message.size() <= 1000 &&
             (data.message.size() >= 1 || (('messageType' in data) && data.messageType in ['AUDIO', 'IMAGE', 'PDF', 'FILE'])) &&
             (!('messageType' in data) || data.messageType in ['TEXT', 'AUDIO', 'IMAGE', 'PDF', 'FILE']) &&
             (!('attachmentName' in data) || (data.attachmentName is string && data.attachmentName.size() <= 200)) &&
             (!('attachmentMimeType' in data) || (data.attachmentMimeType is string && data.attachmentMimeType.size() <= 120)) &&
             (!('attachmentSizeBytes' in data) || (data.attachmentSizeBytes is number && data.attachmentSizeBytes >= 0 && data.attachmentSizeBytes <= 10485760)) &&
             (!('attachmentDurationMs' in data) || (data.attachmentDurationMs is number && data.attachmentDurationMs >= 0)) &&
             (!('attachmentChunkCount' in data) || (data.attachmentChunkCount is number && data.attachmentChunkCount >= 0 && data.attachmentChunkCount <= 40)) &&
             (!('expiresAtMs' in data) || data.expiresAtMs is number) &&
             data.createdAtMs is number &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isSameStationAsUser(stationCode) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.oicStationCode == stationCode;
    }

    match /station_chats/{messageId} {
      allow read: if isSignedIn() && (
                     resource.data.senderUid == request.auth.uid ||
                     isSameStationAsUser(resource.data.oicStationCode)
                  );
      allow create: if isSignedIn() && isValidStationChatMessage(incoming());
      allow delete: if isSignedIn() && (
                       resource.data.senderUid == request.auth.uid ||
                       isOIC() ||
                       (isSameStationAsUser(resource.data.oicStationCode) &&
                        ('expiresAtMs' in resource.data) &&
                        resource.data.expiresAtMs > 0 &&
                        resource.data.expiresAtMs <= request.time.toMillis())
                    );

      match /chunks/{chunkIndex} {
        allow read: if isSignedIn() && (
                       resource.data.senderUid == request.auth.uid ||
                       isSameStationAsUser(resource.data.oicStationCode)
                    );
        allow create: if isSignedIn() &&
                         incoming().senderUid == request.auth.uid &&
                         incoming().oicStationCode is string &&
                         incoming().oicStationCode.size() >= 1 &&
                         incoming().oicStationCode.size() <= 64 &&
                         incoming().chunkIndex is number &&
                         incoming().chunkIndex >= 0 &&
                         incoming().chunkIndex < 40 &&
                         incoming().data is string &&
                         incoming().data.size() >= 1 &&
                         incoming().data.size() <= 750000 &&
                         (!('expiresAtMs' in incoming()) || incoming().expiresAtMs is number);
        allow delete: if isSignedIn() && (
                         resource.data.senderUid == request.auth.uid ||
                         isOIC() ||
                         (isSameStationAsUser(resource.data.oicStationCode) &&
                          ('expiresAtMs' in resource.data) &&
                          resource.data.expiresAtMs > 0 &&
                          resource.data.expiresAtMs <= request.time.toMillis())
                      );
      }
    }

    function isValidLiveMonitorSession(data) {
      return data.sessionId is string && data.sessionId.size() >= 1 && data.sessionId.size() <= 128 &&
             data.oicStationCode is string && data.oicStationCode.size() >= 1 && data.oicStationCode.size() <= 64 &&
             data.oicUid is string &&
             data.oicName is string && data.oicName.size() <= 120 &&
             data.officerUid is string &&
             data.officerName is string && data.officerName.size() <= 120 &&
             data.status in ['REQUESTED', 'ACTIVE', 'NEEDS_FOREGROUND', 'ENDED'] &&
             data.requestedCamera is bool &&
             data.requestedAudio is bool &&
             data.cameraActive is bool &&
             data.micActive is bool &&
             data.lensFacing in ['BACK', 'FRONT'] &&
             data.createdAtMs is number &&
             data.updatedAtMs is number &&
             data.expiresAtMs is number &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time));
    }

    match /live_monitors/{sessionId} {
      allow read: if isSignedIn() && (
                     resource.data.oicUid == request.auth.uid ||
                     resource.data.officerUid == request.auth.uid
                  );
      allow create: if isSignedIn() &&
                       isOIC() &&
                       incoming().oicUid == request.auth.uid &&
                       incoming().status == 'REQUESTED' &&
                       isSameStationAsUser(incoming().oicStationCode) &&
                       get(/databases/$(database)/documents/users/$(incoming().officerUid)).data.oicStationCode == incoming().oicStationCode &&
                       isValidLiveMonitorSession(incoming());
      allow update: if isSignedIn() && (
                       (existing().oicUid == request.auth.uid &&
                        incoming().oicUid == existing().oicUid &&
                        incoming().officerUid == existing().officerUid &&
                        incoming().oicStationCode == existing().oicStationCode &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'lensFacing', 'requestedCamera', 'requestedAudio', 'updatedAtMs', 'expiresAtMs'])) ||
                       (existing().officerUid == request.auth.uid &&
                        incoming().oicUid == existing().oicUid &&
                        incoming().officerUid == existing().officerUid &&
                        incoming().oicStationCode == existing().oicStationCode &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'cameraActive', 'micActive', 'updatedAtMs', 'expiresAtMs']))
                    ) && isValidLiveMonitorSession(incoming());
      allow delete: if isSignedIn() && (
                       resource.data.oicUid == request.auth.uid ||
                       resource.data.officerUid == request.auth.uid
                    );

      match /video_slots/{slotId} {
        allow read: if isSignedIn() && (
                       resource.data.oicUid == request.auth.uid ||
                       resource.data.officerUid == request.auth.uid
                    );
        allow create, update: if isSignedIn() &&
                                 incoming().officerUid == request.auth.uid &&
                                 get(/databases/$(database)/documents/live_monitors/$(sessionId)).data.officerUid == request.auth.uid &&
                                 get(/databases/$(database)/documents/live_monitors/$(sessionId)).data.oicUid == incoming().oicUid &&
                                 incoming().slotIndex is number && incoming().slotIndex >= 0 && incoming().slotIndex < 8 &&
                                 incoming().seq is number && incoming().seq >= 0 &&
                                 incoming().jpegBase64 is string && incoming().jpegBase64.size() <= 450000 &&
                                 incoming().width is number && incoming().height is number &&
                                 incoming().timestampMs is number &&
                                 incoming().oicUid is string &&
                                 incoming().oicStationCode is string;
        allow delete: if isSignedIn() && (
                         resource.data.officerUid == request.auth.uid ||
                         resource.data.oicUid == request.auth.uid
                      );
      }

      match /audio_chunks/{slotId} {
        allow read: if isSignedIn() && (
                       resource.data.oicUid == request.auth.uid ||
                       resource.data.officerUid == request.auth.uid
                    );
        allow create, update: if isSignedIn() &&
                                 incoming().officerUid == request.auth.uid &&
                                 get(/databases/$(database)/documents/live_monitors/$(sessionId)).data.officerUid == request.auth.uid &&
                                 get(/databases/$(database)/documents/live_monitors/$(sessionId)).data.oicUid == incoming().oicUid &&
                                 incoming().slotIndex is number && incoming().slotIndex >= 0 && incoming().slotIndex < 16 &&
                                 incoming().seq is number && incoming().seq >= 0 &&
                                 incoming().adpcmBase64 is string && incoming().adpcmBase64.size() <= 150000 &&
                                 incoming().sampleRate is number && incoming().sampleRate >= 8000 && incoming().sampleRate <= 48000 &&
                                 incoming().sampleCount is number && incoming().sampleCount >= 0 &&
                                 incoming().timestampMs is number &&
                                 incoming().oicUid is string &&
                                 incoming().oicStationCode is string;
        allow delete: if isSignedIn() && (
                         resource.data.officerUid == request.auth.uid ||
                         resource.data.oicUid == request.auth.uid
                      );
      }
    }
  }
}
