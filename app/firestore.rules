rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /duty_records/{recordId} {
      allow read, write: if request.auth != null && (request.auth.uid == resource.data.officerId || request.auth.token.role == 'OIC');
    }
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
